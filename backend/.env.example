PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/jumpstart
JWT_SECRET=your-super-secret-jwt-key-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://jump-start-ten.vercel.app
ADMIN_NAME=Jumpstart Admin
ADMIN_EMAIL=admin@jumpstart.local
ADMIN_PASSWORD=  
# Supported UI languages (frontend reads its own list, but the backend
# declares the canonical set here so future API responses and emails
# can route by locale). First-class regional locale: Gujarati (gu).
SUPPORTED_LANGUAGES=en,gu
DEFAULT_LANGUAGE=en
# Required only by scripts/translateQuestionsToGujarati.mjs — bulk-translates the
# 500-question bank into Gujarati. Leave unset in normal app runtime.

# Payments
# Lets POST /api/v1/user/package/purchase grant a paid package without a
# gateway. The endpoint writes the entitlement outright and verifies no
# payment, so it is disabled (503) unless this is exactly "true".
# The free demo package bypasses the guard and always works.
# Dev/staging only. Never 'true' in production once Razorpay is live.
ALLOW_FREE_PURCHASE=false

# Razorpay (Tier 1 - package / report access purchase).
# Not in config/env.js REQUIRED_ENV_VARS on purpose: dev and staging boot
# without these and use ALLOW_FREE_PURCHASE=true instead. server.js warns
# at startup when both are absent.
# Test keys look like rzp_test_*; live keys rzp_live_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend build-time copy of the PUBLIC key id. Belongs in frontend/.env,
# listed here so the pair is documented together. Vite inlines VITE_* at
# BUILD time, so changing it needs a rebuild, not just a restart. It must
# match RAZORPAY_KEY_ID above.
# VITE_RAZORPAY_KEY_ID=

# Webhook signing secret. This is a DIFFERENT value from
# RAZORPAY_KEY_SECRET above - you choose it in the Razorpay dashboard when
# registering the webhook endpoint, and Razorpay signs each delivery with
# it. Mixing the two silently fails every signature check.
# Subscribe the endpoint to: payment.captured, payment.failed,
# refund.created, refund.processed.
# Endpoint URL: https://<host>/api/v1/user/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend - https://resend.com). Optional: without RESEND_API_KEY
# the server boots and skips sending (logged). Emails use the branded
# Resend template "jumpstride-base" (logo, name, company footer) — edit
# its look in the Resend dashboard, not in code.
RESEND_API_KEY=
# Must be on a domain verified in Resend (e.g. "Jumpstride <noreply@jumpstride.in>").
# Left empty, falls back to onboarding@resend.dev, which only delivers to
# the Resend account owner's own address — fine for testing only.
EMAIL_FROM=
# Optional: where replies go, e.g. connect@jumpstride.in
EMAIL_REPLY_TO=
# Optional: template id/alias override (default: jumpstride-base)
RESEND_TEMPLATE_ID=
