{
  "name": "jumpstart-backend",
  "version": "1.0.0",
  "description": "MERN backend for Jumpstart career assessment",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:watch": "node --watch server.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "generate:assessment-500": "node scripts/generateComprehensive500Package.mjs",
    "repair:section4": "node scripts/repairSection4QuestionBank.mjs",
    "enrich:personality-csv": "node scripts/enrichPersonalityCsv.mjs",
    "smoke:career-500q": "node scripts/smokeCareer500qScoring.mjs",
    "seed:assessment": "node scripts/seedAssessmentFromJson.mjs",
    "seed:admin": "node scripts/seedAdmin.mjs",
    "seed:demo-package": "node scripts/seedDemoPackage.mjs",
    "seed:gujarati-package": "node scripts/seedGujaratiPackage.mjs",
    "migrate:jumpstart-ids": "node scripts/assignJumpstartIds.mjs",
    "patch:work-style-questions": "node scripts/patchWorkStyleQuestions.mjs",
    "patch:math-operators": "node scripts/patchMathOperators.mjs",
    "translate:questions:gu": "node scripts/translateQuestionsToGujarati.mjs",
    "export:answer-key": "node scripts/exportSection4AnswerKey.mjs",
    "export:answer-keys": "node scripts/exportFullAnswerKey.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^9.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8"
  }
}
